<?xml version="1.0" encoding="utf-8"?>
<!--
    Card background for the call-waiting banner with rounded corners.
    Colour is deliberately kept #00000000 so the card elevation shadow is
    the only visual differentiation — the card itself picks up the window
    background via MaterialCardView's theme.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/call_card_corner_radius" />
    <solid android:color="#1AFFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#26FFFFFF" />
</shape>
